playwright-report/
test-results/
.blob_report/

# Coverage / profiling (can embed local paths)
coverage.xml
*.prof

# Shell history (often contains accidental `export KEY=...`)
.bash_history
.zsh_history

# graph
*.png

# Txt files
*.txt

# PDF files
*.pdf

# Frontend
node_modules

# Outputs (research HTML/JSONL may contain model text, tickers, or paths — treat as sensitive)
outputs/
/scratchpad/
scratch/
tmp/
temp/

# Database files (users will have their own local databases)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Alembic (keep migration files, but ignore generated/cache files)
app/backend/alembic/versions/__pycache__/